+pub(crate) async fn refresh_lan_listener(state: &AppState) {
+    let enabled = state.settings.read().await.lan_access_enabled;
+    if enabled == state.remote_server.primary_is_lan() {
+        return;
+    }
+    if !state.remote_server.running() {
