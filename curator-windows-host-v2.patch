+        assert_eq!(feed.seen_pool.len(), 15);
+        assert_eq!(feed.recent.len(), 10, "recent window stays bounded");
+        // Re-showing an id does not duplicate the recycle pool.
+        feed_note_seen(&mut feed, &state_machine_item(0, "image", 3, None));
