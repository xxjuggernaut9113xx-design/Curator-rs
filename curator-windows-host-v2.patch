+    fn review_undo_restores_the_pre_mutation_snapshot() {
+        let item = state_machine_item(1, "image", 5, None);
+        let mut review = ReviewState {
+            current: Some(state_machine_item(2, "image", 0, None)),
+            ..Default::default()
+        };
+        review
+            .undo_stack
+            .push((item.clone(), "token-1".to_string()));
